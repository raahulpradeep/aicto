#!/usr/bin/env bash
# cto — CLI for the AI CTO workspace.
#
# Manages multi-agent teams: each team is a git repo with its own beads
# tracker; agents (manager, developers, reviewers) run as tmux windows
# inside a per-team session. Coordination happens entirely through bd.
#
# See README.md for usage.

set -euo pipefail

# --------------------------------------------------------------------------
# globals & helpers
# --------------------------------------------------------------------------

CTO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TEAMS_DIR="$CTO_ROOT/teams"
TEMPLATES_DIR="$CTO_ROOT/templates"

die()  { printf 'cto: %s\n' "$*" >&2; exit 1; }
warn() { printf 'cto: %s\n' "$*" >&2; }
info() { printf '%s\n' "$*"; }

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"
}

# Required everywhere.
for cmd in git bd tmux jq python3; do require_cmd "$cmd"; done

# Validate a team name and ensure it exists.
require_team() {
  local name="$1"
  [[ -n "$name" ]] || die "team name required"
  [[ "$name" =~ ^[a-z0-9][a-z0-9._-]*$ ]] || die "invalid team name: $name (lowercase, alnum, .-_ )"
  [[ -d "$TEAMS_DIR/$name" ]] || die "team not found: $name (try: cto team list)"
}

team_dir() { printf '%s/%s' "$TEAMS_DIR" "$1"; }
team_config_path() { printf '%s/.cto/config.yaml' "$(team_dir "$1")"; }

# Read a key from a team's .cto/config.yaml. Usage: cfg_get <team> <key> [default]
cfg_get() {
  local team="$1" key="$2" default="${3-}"
  local path
  path="$(team_config_path "$team")"
  python3 - "$path" "$key" "$default" <<'PY'
import sys, os
path, key, default = sys.argv[1], sys.argv[2], sys.argv[3]
data = {}
if os.path.exists(path):
    # Minimal YAML parser: supports flat key: value lines and lists like [].
    # We avoid pyyaml so the script has no extra deps.
    with open(path) as f:
        for line in f:
            line = line.split('#', 1)[0].rstrip()
            if not line or ':' not in line:
                continue
            k, _, v = line.partition(':')
            k = k.strip(); v = v.strip()
            if v.startswith('[') and v.endswith(']'):
                v = [x.strip().strip('"\'') for x in v[1:-1].split(',') if x.strip()]
            elif v.lower() in ('true', 'false'):
                v = v.lower() == 'true'
            elif v.isdigit():
                v = int(v)
            else:
                v = v.strip('"\'')
            data[k] = v
val = data.get(key, default)
if isinstance(val, list):
    print(' '.join(val))
elif isinstance(val, bool):
    print('true' if val else 'false')
else:
    print(val)
PY
}

# Set a key in a team's .cto/config.yaml.
cfg_set() {
  local team="$1" key="$2" value="$3"
  local path
  path="$(team_config_path "$team")"
  python3 - "$path" "$key" "$value" <<'PY'
import sys, os, re
path, key, value = sys.argv[1], sys.argv[2], sys.argv[3]
lines = []
found = False
if os.path.exists(path):
    with open(path) as f:
        lines = f.readlines()
out = []
pattern = re.compile(rf'^\s*{re.escape(key)}\s*:')
for line in lines:
    if pattern.match(line):
        out.append(f"{key}: {value}\n")
        found = True
    else:
        out.append(line)
if not found:
    if out and not out[-1].endswith('\n'):
        out.append('\n')
    out.append(f"{key}: {value}\n")
with open(path, 'w') as f:
    f.writelines(out)
PY
}

# --------------------------------------------------------------------------
# role prompt rendering
# --------------------------------------------------------------------------

render_prompts() {
  local team="$1"
  local tdir; tdir="$(team_dir "$team")"
  local pdir="$tdir/.cto/prompts"
  mkdir -p "$pdir"
  local n_devs n_revs cuse provider
  n_devs="$(cfg_get "$team" developers 2)"
  n_revs="$(cfg_get "$team" reviewers 1)"
  cuse="$(cfg_get "$team" containerUse false)"
  provider="$(cfg_get "$team" agentProvider claude)"

  for role in manager developer reviewer; do
    local src="$TEMPLATES_DIR/$role.md"
    [[ -f "$src" ]] || die "missing template: $src"
    # Manager has no slot.
    if [[ "$role" == "manager" ]]; then
      sed -e "s|{{TEAM}}|$team|g" \
          -e "s|{{TEAM_DIR}}|$tdir|g" \
          -e "s|{{CONTAINER_USE}}|$cuse|g" \
          "$src" > "$pdir/manager.md"
    fi
  done

  # Render N developer prompts (one per slot).
  for i in $(seq 1 "$n_devs"); do
    sed -e "s|{{TEAM}}|$team|g" \
        -e "s|{{TEAM_DIR}}|$tdir|g" \
        -e "s|{{CONTAINER_USE}}|$cuse|g" \
        -e "s|{{SLOT}}|dev-$i|g" \
        "$TEMPLATES_DIR/developer.md" > "$pdir/dev-$i.md"
  done

  # Render M reviewer prompts.
  for i in $(seq 1 "$n_revs"); do
    sed -e "s|{{TEAM}}|$team|g" \
        -e "s|{{TEAM_DIR}}|$tdir|g" \
        -e "s|{{CONTAINER_USE}}|$cuse|g" \
        -e "s|{{SLOT}}|review-$i|g" \
        "$TEMPLATES_DIR/reviewer.md" > "$pdir/review-$i.md"
  done

  # Generate kimi agent YAML specs when provider is kimi.
  if [[ "$provider" == "kimi" ]]; then
    _render_kimi_agent "$pdir/manager.md" "$team" "manager" "manager"
    for i in $(seq 1 "$n_devs"); do
      _render_kimi_agent "$pdir/dev-$i.md" "$team" "developer" "dev-$i"
    done
    for i in $(seq 1 "$n_revs"); do
      _render_kimi_agent "$pdir/review-$i.md" "$team" "reviewer" "review-$i"
    done
  fi

  # Clean up stale slot files (e.g. after reducing dev/reviewer count).
  shopt -s nullglob
  for f in "$pdir"/dev-*.md; do
    local slot; slot="$(basename "$f" .md)"; slot="${slot#dev-}"
    if (( slot > n_devs )); then rm -f "$f"; fi
  done
  for f in "$pdir"/review-*.md; do
    local slot; slot="$(basename "$f" .md)"; slot="${slot#review-}"
    if (( slot > n_revs )); then rm -f "$f"; fi
  done
  for f in "$pdir"/dev-*.yaml; do
    local slot; slot="$(basename "$f" .yaml)"; slot="${slot#dev-}"
    if (( slot > n_devs )); then rm -f "$f"; fi
  done
  for f in "$pdir"/review-*.yaml; do
    local slot; slot="$(basename "$f" .yaml)"; slot="${slot#review-}"
    if (( slot > n_revs )); then rm -f "$f"; fi
  done
  if [[ "$provider" != "kimi" && -f "$pdir/manager.yaml" ]]; then
    rm -f "$pdir/manager.yaml"
  fi
  shopt -u nullglob
}

# Generate a kimi agent YAML spec that references a rendered role prompt.
_render_kimi_agent() {
  local role_file="$1" team="$2" role="$3" slot="$4"
  local yaml_file="${role_file%.md}.yaml"
  cat > "$yaml_file" <<EOF
version: 1
agent:
  name: "$team:$slot"
  system_prompt_path: "$role_file"
  system_prompt_args: {}
  tools:
    - "kimi_cli.tools.agent:Agent"
    - "kimi_cli.tools.ask_user:AskUserQuestion"
    - "kimi_cli.tools.todo:SetTodoList"
    - "kimi_cli.tools.shell:Shell"
    - "kimi_cli.tools.background:TaskList"
    - "kimi_cli.tools.background:TaskOutput"
    - "kimi_cli.tools.background:TaskStop"
    - "kimi_cli.tools.file:ReadFile"
    - "kimi_cli.tools.file:ReadMediaFile"
    - "kimi_cli.tools.file:Glob"
    - "kimi_cli.tools.file:Grep"
    - "kimi_cli.tools.file:WriteFile"
    - "kimi_cli.tools.file:StrReplaceFile"
    - "kimi_cli.tools.web:SearchWeb"
    - "kimi_cli.tools.web:FetchURL"
    - "kimi_cli.tools.plan:ExitPlanMode"
    - "kimi_cli.tools.plan.enter:EnterPlanMode"
EOF
}

# --------------------------------------------------------------------------
# tmux helpers
# --------------------------------------------------------------------------

tmux_session() { printf 'cto-%s' "$1"; }
tmux_alive()   { tmux has-session -t "$(tmux_session "$1")" 2>/dev/null; }

# Compute SHA-256 of a file (BSD-or-GNU portable). Empty string if missing.
_file_sha() {
  local f="$1"
  [[ -f "$f" ]] || { printf ''; return; }
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$f" | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$f" | awk '{print $1}'
  else
    printf ''
  fi
}

# reconciler_sync <team> <team-dir> [--force]
# Copies templates/reconciler.py into <team>/.cto/reconciler.py if absent
# or matching. If the team's copy has been hand-edited (hash mismatch),
# refuse to proceed unless --force is passed. Returns 0 on success.
reconciler_sync() {
  local name="$1" tdir="$2" force="${3:-}"
  local src="$TEMPLATES_DIR/reconciler.py"
  local dst="$tdir/.cto/reconciler.py"
  [[ -f "$src" ]] || die "missing template: $src"
  mkdir -p "$tdir/.cto"
  if [[ -f "$dst" && "$force" != "--force" ]]; then
    local sa sb
    sa="$(_file_sha "$src")"
    sb="$(_file_sha "$dst")"
    if [[ -n "$sa" && -n "$sb" && "$sa" != "$sb" ]]; then
      printf 'cto: reconciler drift in %s\n' "$dst" >&2
      printf '  template sha: %s\n  team sha:     %s\n' "$sa" "$sb" >&2
      printf '  diff:\n' >&2
      diff -u "$dst" "$src" | sed 's/^/    /' >&2 || true
      return 1
    fi
  fi
  cp "$src" "$dst"
  chmod +x "$dst"
  return 0
}

cmd_reconciler_sync() {
  local name="${1:-}"; shift || true
  [[ -n "$name" ]] || die "usage: cto reconciler-sync <team> [--force]"
  local force=""
  for arg in "$@"; do
    [[ "$arg" == "--force" ]] && force="--force"
  done
  local tdir; tdir="$(team_dir "$name")"
  [[ -d "$tdir" ]] || die "no such team: $name"
  if reconciler_sync "$name" "$tdir" "$force"; then
    info "reconciler synced: $tdir/.cto/reconciler.py"
  else
    exit 1
  fi
}

# --------------------------------------------------------------------------
# commands
# --------------------------------------------------------------------------

usage() {
  cat <<'EOF'
cto — manage AI CTO teams.

Usage:
  cto team create <name> [--repo <url>] [--developers N] [--reviewers N] [--container-use] [--agent-provider claude|kimi] [--description "…"]
  cto team adopt  <name> <path>  [--copy] [--developers N] [--reviewers N] [--container-use] [--agent-provider claude|kimi]
  cto team list
  cto team remove <name>
  cto config <name> [--developers N] [--reviewers N] [--scale] [--container-use on|off] [--permission-mode MODE] [--model M] [--manager-model M] [--reviewer-model M] [--agent-provider claude|kimi]

  cto task <team> "<title>" [-d "<desc>"] [-p N] [--epic|--dev|--plan] [--ops] [--require-cto|--bypass-cto] [--parent-branch <branch>]
  cto inbox [<team>] [--json]
  cto approve <team> <id> [--comment "…"]
  cto reject <team> <id> --comment "…"
  cto review                                # interactive TUI inbox

  cto start <team> [--attach] [--dangerous] [--persistent]
  cto stop <team>
  cto restart <team> [--persistent]
  cto attach <team> [<window>]

  cto status [<team>]
  cto update <team> [--fresh]
  cto reconciler-sync <team> [--force]
  cto top                                   # live top-style dashboard (v2)
  cto dashboard [--legacy]                  # launch the event-driven dashboard
  cto activity <team> [-f] [--agent <slot>] [--kind <k>] [--since <iso>] [--limit N]
  cto decisions <team> [--epic <id>]        # browse committed decision log

  cto merge-epic <team> <epic-id>           # CTO-only: merge epic/<id> into its parent branch
  cto worktrees <team>
  cto worktrees prune <team>
  cto exec <team> -- <cmd…>

Run any subcommand with no args for context-specific help.
EOF
}

# ---- shared scaffolding (used by `team create` and `team adopt`) --------
#
# Assumes teams/<name>/ exists as a git repo with at least one commit on
# `main`. Layers the AI CTO operating model on top: dirs, .gitignore,
# config.yaml, CLAUDE.md, AGENTS.md, bd init, role prompts, final commit.

_team_scaffold() {
  local name="$1" devs="$2" revs="$3" cuse="$4" provider="${5:-claude}"
  local tdir="$TEAMS_DIR/$name"

  mkdir -p "$tdir/.cto/prompts" "$tdir/.cto/worktrees" \
            "$tdir/breakdowns" "$tdir/plans" "$tdir/docs/reviews"
  : > "$tdir/.cto/worktrees/.gitkeep"
  [[ -e "$tdir/breakdowns/.gitkeep" ]]   || : > "$tdir/breakdowns/.gitkeep"
  [[ -e "$tdir/plans/.gitkeep" ]]        || : > "$tdir/plans/.gitkeep"
  [[ -e "$tdir/docs/reviews/.gitkeep" ]] || : > "$tdir/docs/reviews/.gitkeep"

  # Append cto-managed gitignore lines (idempotent).
  if ! grep -qxF '.cto/worktrees/' "$tdir/.gitignore" 2>/dev/null; then
    printf '\n# cto\n.cto/worktrees/\n.cto/prompts/\n.cto/locks/\n' >> "$tdir/.gitignore"
  fi

  local default_model default_manager_model
  if [[ "$provider" == "kimi" ]]; then
    default_model="kimi-code/kimi-for-coding"
    default_manager_model="kimi-code/kimi-for-coding"
  elif [[ "$provider" == "codex" ]]; then
    default_model="gpt-5.4"
    default_manager_model="gpt-5.4"
  else
    default_model="sonnet"
    default_manager_model="claude-opus-4-6"
  fi

  cat > "$tdir/.cto/config.yaml" <<EOF
# AI CTO team config — edit via 'cto config $name …', not by hand.
developers: $devs
reviewers: $revs
manager: true
permissionMode: bypassPermissions
containerUse: $cuse
agentProvider: $provider
model: $default_model
managerModel: $default_manager_model
reviewerModel: $default_model
extraArgs: []
EOF

  # Compose CLAUDE.md / AGENTS.md. If the adopted repo already has them,
  # back them up so we don't clobber project docs silently.
  for f in CLAUDE.md AGENTS.md; do
    if [[ -f "$tdir/$f" && ! -f "$tdir/.cto/orig-$f" ]]; then
      cp "$tdir/$f" "$tdir/.cto/orig-$f"
    fi
  done

  sed -e "s|{{TEAM}}|$name|g" \
      -e "s|{{TEAM_DIR}}|$tdir|g" \
      -e "s|{{N_DEVS}}|$devs|g" \
      -e "s|{{N_REVIEWERS}}|$revs|g" \
      -e "s|{{CONTAINER_USE}}|$cuse|g" \
      "$TEMPLATES_DIR/team-CLAUDE.md" > "$tdir/CLAUDE.md"
  sed -e "s|{{TEAM}}|$name|g" \
      "$TEMPLATES_DIR/team-AGENTS.md" > "$tdir/AGENTS.md"

  # If we backed up an original CLAUDE.md, append a pointer to it.
  if [[ -f "$tdir/.cto/orig-CLAUDE.md" ]]; then
    printf '\n## Original project CLAUDE.md\n\nPreserved at `.cto/orig-CLAUDE.md`. Merge in any project-specific guidance you want agents to follow.\n' \
      >> "$tdir/CLAUDE.md"
  fi

  # bd init only if not already initialized (adopted repo may have one).
  if [[ ! -d "$tdir/.beads" ]]; then
    ( cd "$tdir" && bd init >/dev/null )
  else
    info "  (existing .beads found in adopted repo — leaving it alone)"
  fi

  # Install a post-commit hook to emit commit_pushed events for telemetry.
  mkdir -p "$tdir/.git/hooks"
  cat > "$tdir/.git/hooks/post-commit" <<HOOK
#!/usr/bin/env bash
branch=\$(git symbolic-ref --short HEAD 2>/dev/null || echo "detached")
hash=\$(git rev-parse HEAD)
msg=\$(git log -1 --pretty=%s)
author=\$(git log -1 --pretty=%an)
python3 - "\$branch" "\$hash" "\$msg" "\$author" <<'PY'
import json, datetime, sys
branch, hash, msg, author = sys.argv[1:5]
event = {
    "ts": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    "event": "commit_pushed",
    "branch": branch,
    "commit_hash": hash,
    "message": msg,
    "author": author,
}
with open("$tdir/.cto/activity.jsonl", "a") as f:
    f.write(json.dumps(event, separators=(",", ":")) + "\n")
PY
HOOK
  chmod +x "$tdir/.git/hooks/post-commit"

  render_prompts "$name"

  git -C "$tdir" add -A
  if ! git -C "$tdir" diff --cached --quiet; then
    git -C "$tdir" -c commit.gpgsign=false commit -m "cto: scaffold team config" >/dev/null
  fi
}

# ---- team create ---------------------------------------------------------

cmd_team_create() {
  local name="" repo="" desc="" devs=2 revs=1 cuse=false provider="claude"
  while (( $# )); do
    case "$1" in
      --repo) repo="$2"; shift 2 ;;
      --developers) devs="$2"; shift 2 ;;
      --reviewers)  revs="$2"; shift 2 ;;
      --container-use) cuse=true; shift ;;
      --agent-provider) provider="$2"; shift 2 ;;
      --description|-d) desc="$2"; shift 2 ;;
      --) shift; break ;;
      -*) die "unknown flag for team create: $1" ;;
      *) [[ -z "$name" ]] && name="$1" || die "extra arg: $1"; shift ;;
    esac
  done
  [[ -n "$name" ]] || die "team create: name required"
  [[ "$name" =~ ^[a-z0-9][a-z0-9._-]*$ ]] || die "invalid team name: $name"
  [[ ! -e "$TEAMS_DIR/$name" ]] || die "team already exists: $name"
  [[ "$devs" =~ ^[0-9]+$ ]] || die "--developers must be an integer"
  [[ "$revs" =~ ^[0-9]+$ ]] || die "--reviewers must be an integer"
  [[ "$provider" == "claude" || "$provider" == "kimi" || "$provider" == "codex" ]] || die "--agent-provider must be claude, kimi, or codex"

  local tdir="$TEAMS_DIR/$name"
  info "creating team: $name (devs=$devs, reviewers=$revs, container-use=$cuse, agent-provider=$provider)"

  if [[ -n "$repo" ]]; then
    git clone "$repo" "$tdir"
  else
    mkdir -p "$tdir"
    git -C "$tdir" init -b main >/dev/null
    : > "$tdir/.gitkeep"
    git -C "$tdir" add .gitkeep >/dev/null
    git -C "$tdir" -c commit.gpgsign=false commit -m "init team: $name${desc:+ — $desc}" >/dev/null
  fi

  _team_scaffold "$name" "$devs" "$revs" "$cuse" "$provider"

  info "team created at: $tdir"
  info "next: cto task $name \"<epic title>\" --epic && cto start $name"
}

# ---- team adopt ----------------------------------------------------------
#
# Bring an existing local directory into teams/<name>/. Handles both bare
# directories (no .git) and existing git repos. By default the source is
# moved; pass --copy to copy it instead.

cmd_team_adopt() {
  local name="" src="" devs=2 revs=1 cuse=false copy=false provider="claude"
  while (( $# )); do
    case "$1" in
      --developers) devs="$2"; shift 2 ;;
      --reviewers)  revs="$2"; shift 2 ;;
      --container-use) cuse=true; shift ;;
      --agent-provider) provider="$2"; shift 2 ;;
      --copy) copy=true; shift ;;
      --) shift; break ;;
      -*) die "unknown flag for team adopt: $1" ;;
      *)
        if   [[ -z "$name" ]]; then name="$1"
        elif [[ -z "$src"  ]]; then src="$1"
        else die "extra arg: $1"
        fi
        shift ;;
    esac
  done
  [[ -n "$name" && -n "$src" ]] || die "usage: cto team adopt <name> <path-to-existing-dir> [--copy] [--developers N] [--reviewers N] [--container-use] [--agent-provider claude|kimi]"
  [[ "$name" =~ ^[a-z0-9][a-z0-9._-]*$ ]] || die "invalid team name: $name"
  [[ ! -e "$TEAMS_DIR/$name" ]] || die "team already exists: $name"
  [[ -d "$src" ]] || die "source not found or not a directory: $src"
  src="$(cd "$src" && pwd)"
  [[ "$src" != "$TEAMS_DIR/$name" ]] || die "source is already the team path"
  case "$src" in "$CTO_ROOT"|"$CTO_ROOT"/*) die "cannot adopt a path inside the CTO workspace: $src" ;; esac
  [[ "$provider" == "claude" || "$provider" == "kimi" || "$provider" == "codex" ]] || die "--agent-provider must be claude, kimi, or codex"

  local tdir="$TEAMS_DIR/$name"
  info "adopting: $src → teams/$name (copy=$copy, devs=$devs, reviewers=$revs, container-use=$cuse, agent-provider=$provider)"

  if $copy; then
    mkdir -p "$tdir"
    # Use rsync if available for speed + correctness; fall back to cp -R.
    if command -v rsync >/dev/null 2>&1; then
      rsync -a "$src"/ "$tdir"/
    else
      cp -R "$src"/. "$tdir"/
    fi
  else
    mv "$src" "$tdir"
  fi

  # Ensure it's a git repo on `main` with at least one commit.
  if [[ ! -d "$tdir/.git" ]]; then
    info "  no .git found — running git init"
    git -C "$tdir" init -b main >/dev/null
  else
    # Make sure HEAD exists on a branch named main (rename if needed).
    local head_ref
    head_ref="$(git -C "$tdir" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
    if [[ -z "$head_ref" ]]; then
      git -C "$tdir" checkout -b main >/dev/null 2>&1 || true
    elif [[ "$head_ref" != "main" ]]; then
      info "  current branch is '$head_ref'; leaving as-is (worktrees will branch from it)"
    fi
  fi

  # Stage anything not yet committed (typical for a fresh dir or a dirty repo).
  git -C "$tdir" add -A
  if ! git -C "$tdir" diff --cached --quiet; then
    git -C "$tdir" -c commit.gpgsign=false commit -m "adopt: import $name" >/dev/null
  elif ! git -C "$tdir" rev-parse --verify HEAD >/dev/null 2>&1; then
    # Empty repo with no commits — make one so worktrees work.
    : > "$tdir/.gitkeep"
    git -C "$tdir" add .gitkeep >/dev/null
    git -C "$tdir" -c commit.gpgsign=false commit -m "adopt: init empty repo for $name" >/dev/null
  fi

  _team_scaffold "$name" "$devs" "$revs" "$cuse" "$provider"

  info "team adopted at: $tdir"
  info "next: cto task $name \"<epic title>\" --epic && cto start $name"
}

# ---- team list -----------------------------------------------------------

cmd_team_list() {
  shopt -s nullglob
  local found=0
  printf '%-20s %-8s %-8s %-12s %-7s %-14s %s\n' TEAM DEVS REVIEWERS CONTAINER-USE TMUX AGENT-PROVIDER OPEN-ISSUES
  for d in "$TEAMS_DIR"/*/; do
    local name; name="$(basename "$d")"
    [[ "$name" == ".gitkeep" ]] && continue
    [[ -d "$d/.cto" ]] || continue
    found=1
    local devs revs cuse alive provider open
    devs="$(cfg_get "$name" developers 2)"
    revs="$(cfg_get "$name" reviewers 1)"
    cuse="$(cfg_get "$name" containerUse false)"
    provider="$(cfg_get "$name" agentProvider claude)"
    if tmux_alive "$name"; then alive=yes; else alive=no; fi
    open="$(cd "$d" && bd list --status open --json 2>/dev/null | jq 'length' 2>/dev/null || echo '?')"
    printf '%-20s %-8s %-8s %-12s %-7s %-14s %s\n' "$name" "$devs" "$revs" "$cuse" "$alive" "$provider" "$open"
  done
  shopt -u nullglob
  (( found )) || info "no teams yet — try: cto team create <name>"
}

# ---- team remove ---------------------------------------------------------

cmd_team_remove() {
  local name="${1:-}"
  require_team "$name"
  read -r -p "Remove team '$name' and ALL its data? [y/N] " ans
  [[ "$ans" == "y" || "$ans" == "Y" ]] || { info "aborted"; return; }
  if tmux_alive "$name"; then
    tmux kill-session -t "$(tmux_session "$name")" 2>/dev/null || true
  fi
  rm -rf "$(team_dir "$name")"
  info "removed: $name"
}

# ---- config --------------------------------------------------------------

_scale_team() {
  local name="$1"
  local tdir; tdir="$(team_dir "$name")"
  local pdir="$tdir/.cto/prompts"
  local sess; sess="$(tmux_session "$name")"
  local mode model reviewer_model provider
  mode="$(cfg_get "$name" permissionMode bypassPermissions)"
  model="$(cfg_get "$name" model sonnet)"
  reviewer_model="$(cfg_get "$name" reviewerModel "$model")"
  provider="$(cfg_get "$name" agentProvider claude)"
  local launcher="$tdir/.cto/supervisor.sh"

  local n_devs n_revs
  n_devs="$(cfg_get "$name" developers 2)"
  n_revs="$(cfg_get "$name" reviewers 1)"

  # Get currently running windows.
  local -a existing_windows
  existing_windows=($(tmux list-windows -t "$sess" -F '#W' 2>/dev/null))

  # Spawn missing dev windows.
  for i in $(seq 1 "$n_devs"); do
    local win="dev-$i"
    if [[ ! " ${existing_windows[*]} " =~ " $win " ]]; then
      local dev_file="$pdir/dev-$i.md"
      [[ "$provider" == "kimi" ]] && dev_file="$pdir/dev-$i.yaml"
      tmux new-window -t "$sess" -n "$win" -c "$tdir" \
        "$launcher" "$tdir" developer "$win" "$dev_file" "$mode" "$model" "$provider"
      info "scaled up: $win"
    fi
  done

  # Spawn missing reviewer windows.
  for i in $(seq 1 "$n_revs"); do
    local win="review-$i"
    if [[ ! " ${existing_windows[*]} " =~ " $win " ]]; then
      local rev_file="$pdir/review-$i.md"
      [[ "$provider" == "kimi" ]] && rev_file="$pdir/review-$i.yaml"
      tmux new-window -t "$sess" -n "$win" -c "$tdir" \
        "$launcher" "$tdir" reviewer "$win" "$rev_file" "$mode" "$reviewer_model" "$provider"
      info "scaled up: $win"
    fi
  done

  # Kill excess dev windows (Ctrl-C first for graceful cleanup).
  for w in "${existing_windows[@]}"; do
    if [[ "$w" == dev-* ]]; then
      local idx="${w#dev-}"
      if (( idx > n_devs )); then
        tmux send-keys -t "$sess:$w" C-c 2>/dev/null || true
        sleep 2
        tmux kill-window -t "$sess:$w" 2>/dev/null || true
        info "scaled down: $w"
      fi
    fi
  done

  # Kill excess reviewer windows.
  for w in "${existing_windows[@]}"; do
    if [[ "$w" == review-* ]]; then
      local idx="${w#review-}"
      if (( idx > n_revs )); then
        tmux send-keys -t "$sess:$w" C-c 2>/dev/null || true
        sleep 2
        tmux kill-window -t "$sess:$w" 2>/dev/null || true
        info "scaled down: $w"
      fi
    fi
  done
}

cmd_config() {
  local name="${1:-}"; shift || true
  require_team "$name"
  local scale=0
  while (( $# )); do
    case "$1" in
      --developers)      cfg_set "$name" developers "$2";        shift 2 ;;
      --reviewers)       cfg_set "$name" reviewers  "$2";        shift 2 ;;
      --scale)           scale=1; shift ;;
      --container-use)
        case "$2" in
          on|true)  cfg_set "$name" containerUse true ;;
          off|false) cfg_set "$name" containerUse false ;;
          *) die "--container-use takes on|off" ;;
        esac
        shift 2 ;;
      --permission-mode) cfg_set "$name" permissionMode "$2";    shift 2 ;;
      --model)           cfg_set "$name" model "$2";             shift 2 ;;
      --manager-model)   cfg_set "$name" managerModel "$2";      shift 2 ;;
      --reviewer-model)  cfg_set "$name" reviewerModel "$2";     shift 2 ;;
      --agent-provider)
        [[ "$2" == "claude" || "$2" == "kimi" || "$2" == "codex" ]] || die "--agent-provider must be claude, kimi, or codex"
        cfg_set "$name" agentProvider "$2"; shift 2 ;;
      *) die "unknown config flag: $1" ;;
    esac
  done
  render_prompts "$name"
  info "config for $name:"
  cat "$(team_config_path "$name")"
  if (( scale )) && tmux_alive "$name"; then
    _scale_team "$name"
  elif tmux_alive "$name"; then
    info ""
    info "note: team is running — run 'cto restart $name' to apply changes, or use --scale."
  fi
}

# ---- task ---------------------------------------------------------------

cmd_task() {
  local name="${1:-}"; shift || true
  require_team "$name"
  local title="" desc="" prio=2 kind=epic ops=0 bypass_cto=1 parent_branch=""
  while (( $# )); do
    case "$1" in
      -d|--description) desc="$2"; shift 2 ;;
      -p|--priority)    prio="$2"; shift 2 ;;
      --epic) kind=epic; shift ;;
      --dev)  kind=dev;  shift ;;
      --plan) kind=plan; shift ;;
      --ops)  ops=1;     shift ;;
      --bypass-cto)     bypass_cto=1; shift ;;
      --require-cto)    bypass_cto=0; shift ;;
      --parent-branch)  parent_branch="$2"; shift 2 ;;
      --) shift ;;
      -*) die "unknown task flag: $1" ;;
      *) [[ -z "$title" ]] && title="$1" || die "extra arg: $1"; shift ;;
    esac
  done
  if [[ "$kind" != "epic" ]]; then
    bypass_cto=0
  fi
  [[ -n "$title" ]] || die "task title required"
  if (( ops )) && [[ "$kind" != "epic" ]]; then
    die "--ops only applies to epics"
  fi
  if (( bypass_cto && ops )); then
    bypass_cto=0
  fi
  if [[ "$kind" == "epic" && -z "$parent_branch" ]]; then
    die "--parent-branch is required when creating an epic"
  fi

  local labels="role:manager,kind:$kind"
  (( ops )) && labels="$labels,class:ops"
  (( bypass_cto )) && labels="$labels,class:bypass-cto"
  local full_desc="${desc:-(no description)}"
  if [[ -n "$parent_branch" ]]; then
    full_desc="parent_branch: $parent_branch
$full_desc"
  fi
  local id
  id=$(cd "$(team_dir "$name")" && bd create -t task \
        -l "$labels" -p "$prio" \
        -d "$full_desc" \
        --silent \
        "$title")

  # Self-heal: verify labels were persisted (bd occasionally drops them)
  local actual_labels
  actual_labels=$(cd "$(team_dir "$name")" && bd show "$id" --json 2>/dev/null | python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
    labels = data[0].get('labels', []) if data else []
    print(','.join(labels))
except Exception:
    print('')
")
  if [[ "$actual_labels" != *"kind:$kind"* ]]; then
    (cd "$(team_dir "$name")" && bd update "$id" --add-label "$labels" >/dev/null)
    info "label self-heal applied to $id"
  fi

  if (( ops )); then
    info "filed $id (ops epic, role:manager) in team $name — reconciler will file a single dev, no breakdown/plan/review"
  elif (( bypass_cto )); then
    info "filed $id ($kind, role:manager, bypass_cto: true${parent_branch:+, parent_branch: $parent_branch}) in team $name"
  else
    info "filed $id ($kind, role:manager${parent_branch:+, parent_branch: $parent_branch}) in team $name"
  fi
}

# ---- merge ---------------------------------------------------------------
#
# File a kind:merge role:manager bd issue for a given task branch. Used
# manually by the CTO to unstick a workflow when an automatic merge issue
# wasn't filed (e.g. an approval that closed before the auto-merge logic
# was wired up).
#
# In the per-epic-branch model, sub-merges (breakdown/plan/code) target
# epic/<epic-id>, not main. The merge issue carries target:<value> so the
# manager knows what's being merged where.

cmd_merge() {
  local team="${1:-}" branch="${2:-}"; shift 2 2>/dev/null || true
  require_team "$team"
  [[ -n "$branch" ]] || die "usage: cto merge <team> <branch> [--target breakdown|plan|code] [--epic <epic-id>]"
  local target="" epic=""
  while (( $# )); do
    case "$1" in
      --target) target="$2"; shift 2 ;;
      --epic)   epic="$2";   shift 2 ;;
      *) die "unknown merge flag: $1" ;;
    esac
  done
  local tdir; tdir="$(team_dir "$team")"

  # Dedup: skip if there's already an open kind:merge issue for this
  # branch (manager may have filed one when CTO automation lagged).
  local existing
  existing=$(cd "$tdir" && bd list --label "kind:merge" --status open --json 2>/dev/null \
              | jq -r --arg b "$branch" '.[] | select(.description // "" | contains($b)) | .id' | head -1)
  if [[ -n "$existing" ]]; then
    info "merge issue already exists for $branch: $existing (skipping)"
    return 0
  fi

  if ! git -C "$tdir" show-ref --verify --quiet "refs/heads/$branch"; then
    warn "branch '$branch' not found in $tdir — filing merge issue anyway"
  fi

  local labels="role:manager,kind:merge"
  [[ -n "$target" ]] && labels="$labels,target:$target"

  local merge_into="main"
  [[ -n "$epic" ]] && merge_into="epic/$epic"

  local desc="branch: $branch
filed-by: CTO (manual)"
  [[ -n "$epic" ]] && desc="$desc
epic: $epic"
  desc="$desc
action: merge --no-ff into $merge_into, prune the sub-worktree, close this issue."

  local mid
  mid=$(cd "$tdir" && bd create -t task \
          -l "$labels" -p 1 \
          -d "$desc" \
          --silent \
          "Merge $branch")
  info "filed merge issue $mid for $branch (into $merge_into)"
}

# ---- merge-epic ----------------------------------------------------------
#
# CTO-only. Merge epic/<epic-id> into main (or parent_branch) from the team's
# main worktree. Closes the open kind:merge target:epic issue, closes the
# epic itself, and prunes the epic worktree + branch. Idempotent: safe to re-run.

# Read the parent_branch stored in an epic's description. Returns "main" if unset.
# team_root must be the main worktree root (bd only works from there).
epic_parent_branch() {
  local team_root="$1" epic_id="$2"
  local desc
  desc=$(cd "$team_root" && bd show "$epic_id" --json 2>/dev/null \
         | jq -r 'if type=="array" then .[0].description // "" else .description // "" end')
  local pb
  pb=$(grep -oE 'parent_branch:[[:space:]]*[A-Za-z0-9._/-]+' <<<"$desc" \
       | head -1 | sed 's/parent_branch:[[:space:]]*//')
  echo "${pb:-main}"
}

cmd_merge_epic() {
  local team="${1:-}" epic_id="${2:-}"; shift 2 2>/dev/null || true
  require_team "$team"
  [[ -n "$epic_id" ]] || die "usage: cto merge-epic <team> <epic-id>"
  local comment="merged by CTO"
  while (( $# )); do
    case "$1" in
      --comment|-c) comment="$2"; shift 2 ;;
      *) die "unknown flag: $1" ;;
    esac
  done

  local tdir; tdir="$(team_dir "$team")"
  local epic_branch="epic/$epic_id"
  local merge_target
  merge_target="$(epic_parent_branch "$tdir" "$epic_id")"

  if ! git -C "$tdir" show-ref --verify --quiet "refs/heads/$epic_branch"; then
    warn "epic branch '$epic_branch' not found — nothing to merge"
  else
    # Validate that the merge target branch exists locally or on origin.
    git -C "$tdir" show-ref --verify --quiet "refs/heads/$merge_target" \
      || git -C "$tdir" show-ref --verify --quiet "refs/remotes/origin/$merge_target" \
      || die "merge-epic: target branch '$merge_target' not found locally or on origin"

    # Verify the team's main worktree is on the merge target; refuse to coerce.
    local head
    head="$(git -C "$tdir" symbolic-ref --short HEAD 2>/dev/null || true)"
    [[ "$head" == "$merge_target" ]] || die "merge-epic: team main worktree is on '$head', not '$merge_target'; refusing to checkout"

    info "merging $epic_branch into $merge_target"
    # Agents are constantly writing to .beads/issues.jsonl while the team is
    # running. Stash bd state in the main worktree (if dirty) so the merge
    # proceeds cleanly, then pop it back.
    local stashed=0
    if ! git -C "$tdir" diff --quiet -- .beads 2>/dev/null \
       || ! git -C "$tdir" diff --cached --quiet -- .beads 2>/dev/null; then
      if git -C "$tdir" stash push -u -m "cto-merge-epic-$epic_id" -- .beads >/dev/null 2>&1; then
        stashed=1
      fi
    fi

    if ! git -C "$tdir" -c commit.gpgsign=false merge --no-ff "$epic_branch" -m "merge $epic_branch into $merge_target"; then
      warn "merge failed (likely conflict). Resolve in $tdir, then re-run cto merge-epic $team $epic_id."
      (( stashed )) && git -C "$tdir" stash pop >/dev/null 2>&1 || true
      return 1
    fi
    (( stashed )) && git -C "$tdir" stash pop >/dev/null 2>&1 || true
  fi

  # Close the open merge-epic issue, if any.
  local merge_id
  merge_id=$(cd "$tdir" && bd list --status open --label "kind:merge" --label "target:epic" --json 2>/dev/null \
              | jq -r --arg e "$epic_branch" '.[] | select(.description // "" | contains($e)) | .id' | head -1)
  if [[ -n "$merge_id" ]]; then
    ( cd "$tdir" \
        && bd comment "$merge_id" "$comment" >/dev/null \
        && bd update "$merge_id" --add-label "verdict:approved" >/dev/null \
        && bd close   "$merge_id" -r "$comment" >/dev/null )
    info "closed merge-epic issue $merge_id"
  fi

  # Close the epic itself if it's still open. epic_id IS the bd issue id.
  local epic_status
  epic_status=$(cd "$tdir" && bd show "$epic_id" --json 2>/dev/null \
                | jq -r 'if type=="array" then .[0].status // "" else .status // "" end' 2>/dev/null || true)
  if [[ "$epic_status" == "open" || "$epic_status" == "in_progress" ]]; then
    ( cd "$tdir" && bd close "$epic_id" -r "epic merged into $merge_target by CTO" >/dev/null ) || true
    info "closed epic $epic_id"
  fi

  # Prune the epic worktree + branch.
  if [[ -d "$tdir/.cto/worktrees/$epic_id" ]]; then
    git -C "$tdir" worktree remove --force "$tdir/.cto/worktrees/$epic_id" 2>/dev/null || true
    info "removed epic worktree .cto/worktrees/$epic_id"
  fi
  if git -C "$tdir" show-ref --verify --quiet "refs/heads/$epic_branch"; then
    git -C "$tdir" branch -D "$epic_branch" 2>/dev/null || true
    info "deleted branch $epic_branch"
  fi
}

# ---- promote -------------------------------------------------------------
#
# Retrofit existing bd issues with role:* + kind:* labels so the team's
# agents start picking them up. Used when adopting a repo whose issues
# pre-date the cto workflow.

cmd_promote() {
  local team="${1:-}"; shift || true
  require_team "$team"
  local kind=epic
  local ids=()
  while (( $# )); do
    case "$1" in
      --epic) kind=epic; shift ;;
      --dev)  kind=dev;  shift ;;
      --plan) kind=plan; shift ;;
      --) shift ;;
      -*) die "unknown promote flag: $1" ;;
      *) ids+=("$1"); shift ;;
    esac
  done
  (( ${#ids[@]} )) || die "promote: at least one issue id required"
  for id in "${ids[@]}"; do
    ( cd "$(team_dir "$team")" && bd update "$id" --add-label "role:manager,kind:$kind" >/dev/null )
    info "promoted $id → role:manager,kind:$kind"
  done
}

# ---- inbox ---------------------------------------------------------------

cmd_inbox() {
  local target="" json_mode=0
  while (( $# )); do
    case "$1" in
      --json) json_mode=1; shift ;;
      -*) die "unknown flag: $1" ;;
      *) target="$1"; shift ;;
    esac
  done
  shopt -s nullglob
  local any=0
  local accum="[]"
  for d in "$TEAMS_DIR"/*/; do
    local name; name="$(basename "$d")"
    [[ -d "$d/.cto" ]] || continue
    [[ -n "$target" && "$target" != "$name" ]] && continue
    local rows
    rows="$(cd "$d" && bd list --status open -l role:cto --json 2>/dev/null || echo '[]')"
    local count; count="$(jq 'length' <<<"$rows")"
    (( count == 0 )) && continue
    any=1
    if (( json_mode )); then
      local tagged
      tagged="$(jq --arg team "$name" '[.[] | .team = $team]' <<<"$rows")"
      accum="$(jq -s 'add // []' <<<"$accum"$'\n'"$tagged")"
    else
      info "── $name ──"
      jq -r '.[] | "  \(.id)  \(.title)  [\((.labels // []) | join(",") )]"' <<<"$rows"
    fi
  done
  shopt -u nullglob
  if (( json_mode )); then
    echo "$accum"
  else
    (( any )) || info "inbox empty — nothing waiting on the CTO."
  fi
}

# ---- approve / reject ---------------------------------------------------

cmd_approve() {
  local name="${1:-}" id="${2:-}"; shift 2 || true
  require_team "$name"
  [[ -n "$id" ]] || die "approve: issue id required"
  local comment="approved by CTO"
  while (( $# )); do
    case "$1" in
      --comment|-c) comment="$2"; shift 2 ;;
      *) die "unknown flag: $1" ;;
    esac
  done

  local tdir; tdir="$(team_dir "$name")"

  # Snapshot the approval's labels + description before we close it.
  local issue_json labels desc
  issue_json=$(cd "$tdir" && bd show "$id" --json 2>/dev/null) || die "approve: cannot read $id"
  labels=$(jq -r '.[0].labels // [] | join(",")' <<<"$issue_json")
  desc=$(jq -r '.[0].description // ""' <<<"$issue_json")

  # Special case: CTO approving a kind:merge target:epic = "ship the epic".
  # Delegate to cmd_merge_epic which executes the actual git merge,
  # closes the merge issue + epic, and prunes the worktree/branch.
  if [[ "$labels" == *"kind:merge"* && "$labels" == *"target:epic"* ]]; then
    local epic_id
    epic_id=$(grep -oE 'epic[- ]?branch:[[:space:]]*epic/[A-Za-z0-9._-]+' <<<"$desc" \
              | head -1 | sed 's|.*epic/||' || true)
    if [[ -z "$epic_id" ]]; then
      epic_id=$(grep -oE 'epic:[[:space:]]*[A-Za-z0-9._-]+' <<<"$desc" \
                | head -1 | awk -F: '{print $2}' | tr -d '[:space:]' || true)
    fi
    [[ -n "$epic_id" ]] || die "approve: cannot find epic id in merge-epic issue $id description"
    info "target:epic approval — running cto merge-epic $name $epic_id"
    cmd_merge_epic "$name" "$epic_id" --comment "$comment"
    return
  fi

  # Remove any dep that makes the epic block this approval — a common
  # mis-filing by the manager agent that would otherwise hide the approval
  # from `bd ready` forever.
  if [[ -n "$desc" ]]; then
    local epic_id_from_desc
    epic_id_from_desc=$(grep -oE 'epic:[[:space:]]*[A-Za-z0-9._-]+' <<<"$desc" \
                        | head -1 | awk -F: '{print $2}' | tr -d '[:space:]' || true)
    if [[ -n "$epic_id_from_desc" ]]; then
      (cd "$tdir" && bd dep remove "$epic_id_from_desc" --blocks "$id" 2>/dev/null || true)
    fi
  fi

  ( cd "$tdir" \
      && bd comment "$id" "$comment" >/dev/null \
      && bd update "$id" --add-label "verdict:approved" >/dev/null \
      && bd close "$id" -r "$comment" >/dev/null )
  info "approved $id in team $name"

  # If this was a CTO approval of a breakdown or plan, the next workflow
  # step is "manager merges the relevant branch into epic/<id>". Auto-file
  # the merge issue so the team doesn't stall waiting on the human.
  if [[ "$labels" == *"kind:approval"* ]]; then
    local target="" branch="" epic_id=""
    case "$labels" in
      *target:breakdown*) target=breakdown ;;
      *target:plan*)      target=plan ;;
    esac
    # The manager and reviewer prompts both put the branch on a line
    # like "branch manager/<id>" or "branch: manager/<id>" or
    # "@ branch task/<id>". Extract whichever shows up first.
    branch=$(grep -oE '(manager|task)/[A-Za-z0-9._-]+' <<<"$desc" | head -1 || true)
    # Extract epic id (manager prompt always includes "epic: <id>" in the gist).
    epic_id=$(grep -oE 'epic:[[:space:]]*[A-Za-z0-9._-]+' <<<"$desc" \
              | head -1 | awk -F: '{print $2}' | tr -d '[:space:]' || true)

    if [[ -n "$target" && -n "$branch" ]]; then
      if [[ -n "$epic_id" ]]; then
        cmd_merge "$name" "$branch" --target "$target" --epic "$epic_id"
      else
        # Legacy in-flight epic that pre-dates the per-epic-branch model.
        warn "approval $id has no 'epic:' line — filing legacy main-targeted merge"
        cmd_merge "$name" "$branch" --target "$target"
      fi
    elif [[ -n "$target" ]]; then
      warn "approval was for $target but no branch name found in description; no merge issue filed"
    fi
  fi
}

cmd_reject() {
  local name="${1:-}" id="${2:-}"; shift 2 || true
  require_team "$name"
  [[ -n "$id" ]] || die "reject: issue id required"
  local comment=""
  while (( $# )); do
    case "$1" in
      --comment|-c) comment="$2"; shift 2 ;;
      *) die "unknown flag: $1" ;;
    esac
  done
  [[ -n "$comment" ]] || die "reject: --comment required"

  # Find the upstream (the issue this approval depends on) and reopen it
  # with the comment.
  local upstream
  upstream=$(cd "$(team_dir "$name")" && bd dep list "$id" --json 2>/dev/null \
              | jq -r '.dependencies[]? | select(.type=="blocks" or .type=="parent" or .type=="depends_on") | .target_id' \
              | head -1 || true)

  ( cd "$(team_dir "$name")" \
      && bd comment "$id" "REJECTED: $comment" >/dev/null \
      && bd update "$id" --add-label "verdict:rejected" >/dev/null \
      && bd close "$id" -r "rejected: $comment" >/dev/null )

  if [[ -n "$upstream" && "$upstream" != "null" ]]; then
    ( cd "$(team_dir "$name")" \
        && bd reopen "$upstream" >/dev/null \
        && bd comment "$upstream" "Reopened by CTO: $comment" >/dev/null )
    info "rejected $id; reopened upstream $upstream in team $name"
  else
    warn "rejected $id but could not auto-detect upstream — agent must reopen manually"
  fi
}

# ---- start / stop / restart / attach ------------------------------------

cmd_start() {
  local name="${1:-}"; shift || true
  require_team "$name"
  # Persistent supervisors are the default (event-driven, scratchpad-backed,
  # dramatically faster than the legacy stateless bash loop). Pass
  # --no-persistent to fall back to the legacy bash supervisor.
  local attach=0 dangerous=0 force=0 persistent=1
  while (( $# )); do
    case "$1" in
      --attach)        attach=1;    shift ;;
      --dangerous)     dangerous=1; shift ;;
      --force)         force=1;     shift ;;
      --persistent)    persistent=1; shift ;;
      --no-persistent) persistent=0; shift ;;
      *) die "unknown start flag: $1" ;;
    esac
  done

  if tmux_alive "$name"; then
    if (( force )); then
      tmux kill-session -t "$(tmux_session "$name")"
    else
      die "team $name is already running (cto attach $name to view, or --force)"
    fi
  fi

  render_prompts "$name"

  local tdir; tdir="$(team_dir "$name")"
  local pdir="$tdir/.cto/prompts"
  local mode model manager_model reviewer_model provider
  mode="$(cfg_get "$name" permissionMode bypassPermissions)"
  model="$(cfg_get "$name" model sonnet)"
  manager_model="$(cfg_get "$name" managerModel "$model")"
  reviewer_model="$(cfg_get "$name" reviewerModel "$model")"
  provider="$(cfg_get "$name" agentProvider claude)"
  (( dangerous )) && mode="bypassPermissions"
  local n_devs n_revs
  n_devs="$(cfg_get "$name" developers 2)"
  n_revs="$(cfg_get "$name" reviewers 1)"

  local sess; sess="$(tmux_session "$name")"

  # Build the agent command for a given prompt file.
  # Claude: --append-system-prompt with the .md file
  # Kimi: --agent-file with a .yaml spec that points to the .md file

  # Sync the reconciler into the team. The supervisor invokes it after
  # every manager iteration to perform all workflow transitions. Refuse to
  # start if the team's existing copy diverges from the template — a stale
  # reconciler is the kind of thing that has burned us before.
  reconciler_sync "$name" "$tdir" || die "reconciler drift detected; run: cto reconciler-sync $name --force"

  if (( persistent )); then
    # Phase 2: use Python persistent supervisors instead of bash heredocs.
    # Ensure src/ exists in the team dir (symlink from the CTO root).
    local src_dir="$tdir/.cto/src"
    if [[ ! -d "$src_dir" ]]; then
      ln -s "$CTO_ROOT/src" "$src_dir" 2>/dev/null || die "failed to symlink src/ into team .cto/"
    fi
    if [[ -f "$CTO_ROOT/src/wake.py" ]]; then
      cp -f "$CTO_ROOT/src/wake.py" "$tdir/.cto/wake.py"
      chmod +x "$tdir/.cto/wake.py"
    fi
    if [[ -f "$CTO_ROOT/src/merger.py" ]]; then
      cp -f "$CTO_ROOT/src/merger.py" "$tdir/.cto/merger.py"
      chmod +x "$tdir/.cto/merger.py"
    fi

    # Spawn persistent supervisors for each agent slot.
    local manager_file="$pdir/manager.md"
    [[ "$provider" == "kimi" ]] && manager_file="$pdir/manager.yaml"
    tmux new-session -d -s "$sess" -n manager -c "$tdir"       python3 "$src_dir/persistent_supervisor.py" "$tdir" manager manager "$manager_file" "$mode" "$manager_model" "$provider"

    tmux new-window -t "$sess" -n reconciler -c "$tdir"       bash -c '''while :; do python3 "$1/.cto/reconciler.py" --role manager --team-dir "$1" 2>&1 | while IFS= read -r line; do echo "[$(date +%H:%M:%S)] reconciler: $line"; done; if [[ -x "$1/.cto/wake.py" ]]; then python3 "$1/.cto/wake.py" "$1" 3 2>/dev/null || sleep 3; else sleep 3; fi; done''' bash "$tdir"

    if [[ -x "$tdir/.cto/merger.py" ]]; then
      tmux new-window -t "$sess" -n merger -c "$tdir" python3 "$tdir/.cto/merger.py" "$tdir"
    fi

    for i in $(seq 1 "$n_devs"); do
      local dev_file="$pdir/dev-$i.md"
      [[ "$provider" == "kimi" ]] && dev_file="$pdir/dev-$i.yaml"
      tmux new-window -t "$sess" -n "dev-$i" -c "$tdir"         python3 "$src_dir/persistent_supervisor.py" "$tdir" developer "dev-$i" "$dev_file" "$mode" "$model" "$provider"
    done

    for i in $(seq 1 "$n_revs"); do
      local rev_file="$pdir/review-$i.md"
      [[ "$provider" == "kimi" ]] && rev_file="$pdir/review-$i.yaml"
      tmux new-window -t "$sess" -n "review-$i" -c "$tdir"         python3 "$src_dir/persistent_supervisor.py" "$tdir" reviewer "review-$i" "$rev_file" "$mode" "$reviewer_model" "$provider"
    done

    info "started team $name in tmux session: $sess (persistent mode)"
  else
    # Legacy bash supervisor mode (default, backward compatible).
    # Generate a supervisor script.. Each tmux window runs this; the bash
  # loop is what's eternal — the agent CLI is one-shot per iteration.
  # On non-zero exit, the supervisor releases any bd claim it took and,
  # if the failure mentions a permission gap, files a CTO inbox item.
  local launcher="$tdir/.cto/supervisor.sh"
  cat > "$launcher" <<'OUTER'
#!/usr/bin/env bash
# generated by cto — per-agent supervisor loop. Do not edit by hand.
# Args: <team-dir> <role> <slot> <role-prompt-file> <permission-mode> <model> <agent-provider>
set -uo pipefail
TEAM_DIR="$1"; ROLE="$2"; SLOT="$3"; ROLE_FILE="$4"; PERM="$5"; MODEL="$6"; AGENT_PROVIDER="${7:-claude}"
cd "$TEAM_DIR"

# Ensure telemetry helper exists (back-compat for teams started before
# the helper was added to cmd_start).
if [[ ! -f "$TEAM_DIR/.cto/telemetry_helper.py" ]]; then
  cat > "$TEAM_DIR/.cto/telemetry_helper.py" <<'PYEOF'
#!/usr/bin/env python3
import json, datetime, sys, argparse

p = argparse.ArgumentParser()
p.add_argument("log_path")
p.add_argument("event_type")
p.add_argument("--kv", action="append", default=[], metavar="KEY=VALUE")
args = p.parse_args()

event = {
    "ts": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    "event": args.event_type,
}
for kv in args.kv:
    if "=" in kv:
        k, v = kv.split("=", 1)
        event[k] = v

with open(args.log_path, "a", encoding="utf-8") as f:
    f.write(json.dumps(event, separators=(",", ":")) + "\n")
PYEOF
  chmod +x "$TEAM_DIR/.cto/telemetry_helper.py"
fi

# Globally unique agent identity. Used as the bd assignee, the
# filesystem-lock owner stamp, and the agent's self-identifier in
# agent prompts. Team names are unique within the CTO workspace, so
# "<team>:<slot>" is unique across every team.
TEAM=$(basename "$TEAM_DIR")
AGENT="$TEAM:$SLOT"

LOCKS="$TEAM_DIR/.cto/locks"
mkdir -p "$LOCKS"
mkdir -p "$TEAM_DIR/.cto/logs"

AGENT_LOG="$TEAM_DIR/.cto/logs/$AGENT.log"

ts() { date '+%H:%M:%S'; }
log() { printf '[%s %s] %s\n' "$(ts)" "$AGENT" "$*"; }

telemetry_emit() {
  local event_type="$1"; shift
  python3 "$TEAM_DIR/.cto/telemetry_helper.py" \
    "$TEAM_DIR/.cto/activity.jsonl" "$event_type" "$@" 2>/dev/null || true
}

release_claim() {
  local id="$1"
  [[ -z "$id" ]] && return 0
  bd update "$id" --status open --assignee "" >/dev/null 2>&1 || true
  rm -rf "$LOCKS/$id" 2>/dev/null || true
  log "released claim on $id"
  telemetry_emit agent.released --kv "agent=$AGENT" --kv "task_id=$id" --kv "role=$ROLE"
}

escalate_permission() {
  local id="$1" errfile="$2"
  log "escalating permission gap (issue=${id:-none}) to CTO inbox"
  bd create -t task -l "role:cto,kind:permission-blocked" -p 1 \
    --silent \
    --body-file "$errfile" \
    "Agent $AGENT blocked on permissions${id:+ (issue $id)}" \
    >/dev/null 2>&1 || true
}

# Heuristic: did the iteration die on a missing permission?
looks_like_permission_block() {
  grep -qiE 'permission|not[ -]allowed|requires? approval|denied' "$1"
}

trap 'log "supervisor stopping"; exit 0' INT TERM

log "supervisor up (role=$ROLE, provider=$AGENT_PROVIDER, mode=$PERM, model=$MODEL)"

# Boot-time recovery: if a previous instance of this agent was killed
# mid-iteration (tmux kill, machine reboot, etc.), there may be bd
# issues stuck in_progress with our $AGENT assignee, plus stale lock
# dirs we own. Reset them so future iterations can re-attempt.
zombies=$(bd list --status in_progress --json 2>/dev/null \
          | jq -r --arg a "$AGENT" '.[] | select(.assignee == $a) | .id' 2>/dev/null || true)
if [[ -n "$zombies" ]]; then
  for zid in $zombies; do
    log "boot recovery: resetting zombie claim $zid"
    bd update "$zid" --status open --assignee "" >/dev/null 2>&1 || true
    rm -rf "$LOCKS/$zid" 2>/dev/null || true
    telemetry_emit agent_iteration_end --kv "agent=$AGENT" --kv "task_id=$zid" --kv "exit_code=-1" --kv "duration_ms=0"
  done
fi
# Also: any lock dir whose owner stamp matches this agent but has no
# corresponding in_progress bd issue → leftover from a crash. Drop it.
shopt -s nullglob
for ld in "$LOCKS"/*/; do
  [[ -d "$ld" ]] || continue
  owner=$(cat "$ld/owner" 2>/dev/null || true)
  if [[ "$owner" == "$AGENT" ]]; then
    zid=$(basename "$ld")
    rm -rf "$ld"
    log "boot recovery: removed stale lock $zid"
    telemetry_emit agent_iteration_end --kv "agent=$AGENT" --kv "task_id=$zid" --kv "exit_code=-1" --kv "duration_ms=0"
  fi
done
shopt -u nullglob
while :; do
  err=$(mktemp -t cto-err-XXXX)
  task_id=""

  case "$ROLE" in
    manager)
      telemetry_emit manager.pass_started --kv "agent=$AGENT" --kv "role=$ROLE"
      starter="Do one pass per your role manual: (1) close any open kind:status-request issues with a fresh digest; (2) decompose new kind:epic role:manager issues into a breakdown + approval:breakdown (or merge:breakdown for bypass-cto) — YOU must file the approval/merge yourself after closing the breakdown; (3) claim and complete any ready kind:merge role:manager issue; (4) check if any epic is ship-ready and file the kind:merge target:epic yourself if so; (5) update the team's open kind:status-digest issue (or create one if none). Make ONE iteration of incremental progress and exit cleanly. Do not loop yourself — I (the supervisor) will run you again."
      ;;
    developer|reviewer)
      label="role:$ROLE"
      # Atomic claim: walk the ready queue in priority order and try to
      # `mkdir` a per-issue lock directory under .cto/locks/. mkdir is
      # atomic on a local filesystem, so only one slot wins per id.
      # bd's --claim is no help here because it sets assignee = current
      # OS user, which is the same string for every slot in this team.
      task_id=""
      for cand in $(bd ready --label "$label" --json 2>/dev/null \
                    | jq -r 'sort_by(.priority) | .[].id'); do
        if mkdir "$LOCKS/$cand" 2>/dev/null; then
          echo "$AGENT" > "$LOCKS/$cand/owner"
          task_id="$cand"
          break
        fi
      done
      if [[ -z "$task_id" ]]; then
        rm -f "$err"
        if [[ -x "$TEAM_DIR/.cto/wake.py" ]]; then
          python3 "$TEAM_DIR/.cto/wake.py" "$TEAM_DIR" 5 2>/dev/null || sleep 5
        else
          sleep 5
        fi
        continue
      fi

      # Stamp the bd issue with our globally-unique agent identity and
      # flip it to in_progress so it falls out of `bd ready` for everyone.
      if ! bd update "$task_id" --status in_progress --assignee "$AGENT" >/dev/null 2>&1; then
        log "could not flip $task_id to in_progress; releasing"
        release_claim "$task_id"
        rm -f "$err"; sleep 5; continue
      fi
      log "claimed $task_id (assignee=$AGENT)"
      # Gather task metadata for the activity log.
      task_title=$(bd show "$task_id" --json 2>/dev/null | jq -r '.[0].title // "unknown"')
      task_kind=$(bd show "$task_id" --json 2>/dev/null | jq -r '.[0].labels // [] | map(select(startswith("kind:"))) | .[0] // "unknown"')
      telemetry_emit agent.claimed --kv "agent=$AGENT" --kv "task_id=$task_id" --kv "task_title=$task_title" --kv "task_kind=$task_kind" --kv "role=$ROLE"

      if [[ "$ROLE" == developer ]]; then
        starter="You are agent '$AGENT'. You have been assigned bd issue $task_id (already in_progress with assignee=$AGENT). Run 'bd show $task_id' to read it, identify whether it's kind:plan or kind:dev, set up your worktree, do the work, run any project tests/lints, commit on the task branch, and close the bd issue with a short gist (artifact path, branch, files-touched count, one-line test result). AFTER closing, you MUST file the next review issue yourself (plan review or code review with role:reviewer). Do exactly one bd issue this iteration and exit."
      else
        starter="You are agent '$AGENT'. You have been assigned bd review issue $task_id (already in_progress with assignee=$AGENT). Run 'bd show $task_id' to identify the upstream (target:plan or target:code) and what artifact to read. Apply your principal-engineer review; if approved on a plan, file the kind:approval target:plan (or kind:merge target:plan for bypass-cto) yourself; if approved on code, file the kind:merge target:code for the manager yourself; if changes requested, reopen the upstream AND reset THIS review issue to open (assignee='') with 'bd dep add $task_id <upstream-id>' so it blocks until the dev re-closes the upstream — do NOT close the review or file a new round-N re-review. Do exactly one review this iteration and exit."
      fi
      ;;
    *) log "unknown role: $ROLE"; exit 2 ;;
  esac

  # Cross-platform milliseconds timestamp (GNU date supports %3N; BSD does not).
  _ms_ts() {
    if command -v python3 >/dev/null 2>&1; then
      python3 -c "import time; print(int(time.time()*1000))"
    else
      echo "$(($(date +%s) * 1000))"
    fi
  }

  iter_start_ms=$(_ms_ts)
  telemetry_emit agent_iteration_start --kv "agent=$AGENT" --kv "task_id=${task_id:-}"

  if [[ "$AGENT_PROVIDER" == "kimi" ]]; then
    log "invoking kimi (task=${task_id:-none})"
    mcp_args=()
    if [[ -f "$TEAM_DIR/.mcp.json" ]]; then
      mcp_args+=("--mcp-config-file" "$TEAM_DIR/.mcp.json")
    fi
    kimi --print \
      --output-format stream-json \
      --model "$MODEL" \
      --agent-file "$ROLE_FILE" \
      --prompt "$starter" \
      --work-dir "$TEAM_DIR" \
      ${mcp_args[@]+"${mcp_args[@]}"} \
      2> >(tee -a "$AGENT_LOG" "$err" >&2)
    rc=$?
  elif [[ "$AGENT_PROVIDER" == "codex" ]]; then
    log "invoking codex (task=${task_id:-none})"
    # Codex exec is the non-interactive subcommand.  --sandbox workspace-write
    # auto-approves edits and commands within the workdir.
    local codex_args=()
    [[ "$PERM" == "bypassPermissions" ]] && codex_args+=("--sandbox" "workspace-write")
    codex_args+=("--model" "$MODEL")
    # Codex exec has no --append-system-prompt; prepend the role prompt to the
    # user instruction so the agent still receives its role context.
    local full_prompt
    full_prompt="$(cat "$ROLE_FILE")

$starter"
    codex exec \
      --workdir "$TEAM_DIR" \
      "${codex_args[@]}" \
      "$full_prompt" \
      2> >(tee -a "$AGENT_LOG" "$err" >&2)
    rc=$?
  else
    log "invoking claude (task=${task_id:-none})"
    # Stream events as they happen (tool calls + tool results + text)
    # so the tmux pane shows what the agent is actually doing in real
    # time, not just a summary at the end. The jq filter is forgiving:
    # malformed lines are silently dropped (// empty).
    claude --print \
      --output-format stream-json --verbose \
      --permission-mode "$PERM" \
      --model "$MODEL" \
      --append-system-prompt "$(cat "$ROLE_FILE")" \
      "$starter" \
      2> >(tee -a "$AGENT_LOG" "$err" >&2) \
    | jq -r --unbuffered '
        . as $e |
        if $e.type == "assistant" then
          ($e.message.content // [])[]?
          | if .type == "text" and ((.text // "") | length) > 0 then
              .text
            elif .type == "tool_use" then
              "  → " + .name + " " + ((.input // {}) | tostring | if length>140 then .[0:140]+"…" else . end)
            else empty end
        elif $e.type == "user" then
          ($e.message.content // [])[]?
          | select(.type == "tool_result")
          | (.content // "" | tostring | if length>200 then .[0:200]+"…" else . end)
          | "  ← " + .
        else empty end
      ' 2>/dev/null
    rc=${PIPESTATUS[0]}
  fi

  iter_end_ms=$(_ms_ts)
  iter_dur=$((iter_end_ms - iter_start_ms))
  telemetry_emit agent_iteration_end \
    --kv "agent=$AGENT" \
    --kv "task_id=${task_id:-}" \
    --kv "exit_code=$rc" \
    --kv "duration_ms=$iter_dur"
  # Capture last 20 lines of stderr for the activity stream.
  output_preview=""
  if [[ -s "$err" ]]; then
    output_preview=$(tail -n 20 "$err" 2>/dev/null | tr '\n' ' ' | head -c 2000)
  fi
  if [[ -n "$output_preview" ]]; then
    telemetry_emit agent_output \
      --kv "agent=$AGENT" \
      --kv "task_id=${task_id:-}" \
      --kv "output=$output_preview"
  fi

  if (( rc != 0 )); then
    log "$AGENT_PROVIDER exited $rc"
    release_claim "$task_id"
    if [[ "$AGENT_PROVIDER" == "claude" ]] && looks_like_permission_block "$err"; then
      escalate_permission "$task_id" "$err"
      sleep 60   # back off until the human grants permission
    else
      sleep 30
    fi
  else
    # On success the agent should have closed the bd issue itself.
    # If it didn't (forgetful agent / context-window cutoff), the
    # issue is now a zombie: in_progress, assigned to us, but nobody
    # working it. Reset it so the next iteration re-attempts cleanly.
    if [[ -n "$task_id" ]]; then
      st=$(bd show "$task_id" --json 2>/dev/null \
           | jq -r '.[0].status // ""' 2>/dev/null || true)
      if [[ "$st" == "in_progress" ]]; then
        log "agent did not close $task_id (status=$st); resetting to open"
        bd update "$task_id" --status open --assignee "" >/dev/null 2>&1 || true
      fi
      rm -rf "$LOCKS/$task_id" 2>/dev/null
    fi
    log "iteration ok (task=${task_id:-none})"

    if [[ -x "$TEAM_DIR/.cto/wake.py" ]]; then
      [[ "$ROLE" == "manager" ]] && wake_for=10 || wake_for=5
      python3 "$TEAM_DIR/.cto/wake.py" "$TEAM_DIR" "$wake_for" 2>/dev/null || sleep "$wake_for"
    else
      [[ "$ROLE" == "manager" ]] && sleep 10 || sleep 5
    fi
  fi
  rm -f "$err"
done
OUTER
  chmod +x "$launcher"

  # Generate a self-contained telemetry helper so the supervisor can emit
  # workflow events without depending on external Python modules.
  cat > "$tdir/.cto/telemetry_helper.py" <<'PYEOF'
#!/usr/bin/env python3
import json, datetime, sys, argparse

p = argparse.ArgumentParser()
p.add_argument("log_path")
p.add_argument("event_type")
p.add_argument("--kv", action="append", default=[], metavar="KEY=VALUE")
args = p.parse_args()

event = {
    "ts": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    "event": args.event_type,
}
for kv in args.kv:
    if "=" in kv:
        k, v = kv.split("=", 1)
        event[k] = v

with open(args.log_path, "a", encoding="utf-8") as f:
    f.write(json.dumps(event, separators=(",", ":")) + "\n")
PYEOF
  chmod +x "$tdir/.cto/telemetry_helper.py"

  # Install the wake helper used by the supervisor + reconciler loops to
  # interrupt their sleep when bd state changes (event-driven step
  # progression).
  if [[ -f "$CTO_ROOT/src/wake.py" ]]; then
    cp -f "$CTO_ROOT/src/wake.py" "$tdir/.cto/wake.py"
    chmod +x "$tdir/.cto/wake.py"
  fi
  # Install the auto-merger daemon (drains ready manager merges in parallel).
  if [[ -f "$CTO_ROOT/src/merger.py" ]]; then
    cp -f "$CTO_ROOT/src/merger.py" "$tdir/.cto/merger.py"
    chmod +x "$tdir/.cto/merger.py"
  fi

  # Spawn one tmux window per agent slot.
  # For kimi teams, pass the .yaml agent spec; for claude, the .md prompt.
  local manager_file="$pdir/manager.md"
  [[ "$provider" == "kimi" ]] && manager_file="$pdir/manager.yaml"
  tmux new-session -d -s "$sess" -n manager -c "$tdir" \
    "$launcher" "$tdir" manager manager "$manager_file" "$mode" "$manager_model" "$provider"

  tmux new-window -t "$sess" -n reconciler -c "$tdir" \
    bash -c 'while :; do python3 "$1/.cto/reconciler.py" --role manager 2>&1 | while IFS= read -r line; do echo "[$(date +%H:%M:%S)] reconciler: $line"; done; if [[ -x "$1/.cto/wake.py" ]]; then python3 "$1/.cto/wake.py" "$1" 3 2>/dev/null || sleep 3; else sleep 3; fi; done' bash "$tdir"

  if [[ -x "$tdir/.cto/merger.py" ]]; then
    tmux new-window -t "$sess" -n merger -c "$tdir" python3 "$tdir/.cto/merger.py" "$tdir"
  fi

  for i in $(seq 1 "$n_devs"); do
    local dev_file="$pdir/dev-$i.md"
    [[ "$provider" == "kimi" ]] && dev_file="$pdir/dev-$i.yaml"
    tmux new-window -t "$sess" -n "dev-$i" -c "$tdir" \
      "$launcher" "$tdir" developer "dev-$i" "$dev_file" "$mode" "$model" "$provider"
  done

  for i in $(seq 1 "$n_revs"); do
    local rev_file="$pdir/review-$i.md"
    [[ "$provider" == "kimi" ]] && rev_file="$pdir/review-$i.yaml"
    tmux new-window -t "$sess" -n "review-$i" -c "$tdir" \
      "$launcher" "$tdir" reviewer "review-$i" "$rev_file" "$mode" "$reviewer_model" "$provider"
  done

  fi  # close persistent/else
  info "  windows: manager, reconciler, dev-1..$n_devs, review-1..$n_revs"
  info "  agentProvider: $provider, permissionMode: $mode, manager-model: $manager_model, dev-model: $model, reviewer-model: $reviewer_model"
  info "  mode: $([[ $persistent -eq 1 ]] && echo persistent || echo legacy bash)"
  info "  attach: cto attach $name   (Ctrl-b d to detach)"
  if (( attach )); then
    tmux attach -t "$sess"
  fi
}

cmd_stop() {
  local name="${1:-}"
  require_team "$name"
  tmux_alive "$name" || { info "not running: $name"; return; }
  local sess; sess="$(tmux_session "$name")"
  # Send Ctrl-C to each window so agents can flush bd state.
  for w in $(tmux list-windows -t "$sess" -F '#W'); do
    tmux send-keys -t "$sess:$w" C-c 2>/dev/null || true
  done
  sleep 2
  tmux kill-session -t "$sess"
  info "stopped: $name"
}

cmd_restart() {
  local name="${1:-}"; shift || true
  require_team "$name"
  # Persistent supervisors are the default; pass --no-persistent for legacy.
  local persistent=1
  while (( $# )); do
    case "$1" in
      --persistent)    persistent=1; shift ;;
      --no-persistent) persistent=0; shift ;;
      *) die "unknown restart flag: $1" ;;
    esac
  done
  cmd_stop "$name" || true
  if (( persistent )); then
    cmd_start "$name"
  else
    cmd_start "$name" --no-persistent
  fi
}

cmd_attach() {
  local name="${1:-}" win="${2:-}"
  require_team "$name"
  tmux_alive "$name" || die "team not running: $name (try: cto start $name)"
  local sess; sess="$(tmux_session "$name")"
  if [[ -n "$win" ]]; then
    tmux attach -t "$sess:$win"
  else
    tmux attach -t "$sess"
  fi
}

# ---- status / update -----------------------------------------------------

cmd_status() {
  local target="${1:-}"
  if [[ -z "$target" ]]; then
    cmd_team_list
    info ""
    info "── inbox ──"
    cmd_inbox
    return
  fi
  require_team "$target"
  local tdir; tdir="$(team_dir "$target")"
  info "── $target ──"
  ( cd "$tdir" && bd list --status open )
  info ""
  info "── recent digests ──"
  ( cd "$tdir" && bd list --label kind:status-digest --status closed --closed-after "$(date -u -v-1d +%Y-%m-%d 2>/dev/null || date -u --date='1 day ago' +%Y-%m-%d)" 2>/dev/null || true )
  info ""
  if tmux_alive "$target"; then
    info "── tmux: cto:$target ──"
    tmux list-windows -t "$(tmux_session "$target")" -F '  #W'
  else
    info "tmux: not running"
  fi
}

cmd_update() {
  local name="${1:-}"; shift || true
  require_team "$name"
  local fresh=0
  while (( $# )); do
    case "$1" in
      --fresh) fresh=1; shift ;;
      *) die "unknown flag: $1" ;;
    esac
  done

  local tdir; tdir="$(team_dir "$name")"
  if (( fresh )); then
    tmux_alive "$name" || die "team not running; cannot request a fresh digest"
    local req_id
    req_id=$(cd "$tdir" && bd create -t task \
              -l role:manager,kind:status-request -p 1 \
              --silent \
              "Status request from CTO" \
              -d "Please write a fresh digest, then close this issue.")
    info "filed status request: $req_id; waiting up to 60s for the manager..."
    local i
    for i in $(seq 1 30); do
      sleep 2
      local closed
      closed=$(cd "$tdir" && bd show "$req_id" --json 2>/dev/null | jq -r '.[0].status // ""')
      if [[ "$closed" == "closed" ]]; then
        break
      fi
    done
  fi

  # Print the most recent status-digest (open or recently closed).
  local digest
  digest=$(cd "$tdir" && bd list --label kind:status-digest --json 2>/dev/null \
            | jq -r 'sort_by(.updated_at // .created_at) | reverse | .[0] // empty')
  if [[ -z "$digest" ]]; then
    info "(no status digest yet for $name)"
    return
  fi
  jq -r '"id: \(.id)\ntitle: \(.title)\nupdated: \(.updated_at // .created_at)\nstatus: \(.status)\n---\n\(.description)"' <<<"$digest"
}

# ---- worktrees -----------------------------------------------------------

cmd_worktrees() {
  local sub=list name=""
  if [[ "${1:-}" == "prune" ]]; then sub=prune; shift; fi
  name="${1:-}"
  require_team "$name"
  local tdir; tdir="$(team_dir "$name")"
  case "$sub" in
    prune)
      git -C "$tdir" worktree prune -v
      # Snapshot live epic/* heads once so we can check sub-branches against any of them.
      local epic_refs=()
      while IFS= read -r r; do [[ -n "$r" ]] && epic_refs+=("$r"); done < <(
        git -C "$tdir" for-each-ref --format='%(refname:short)' 'refs/heads/epic/' 2>/dev/null
      )
      while IFS=$'\t' read -r path branch; do
        [[ -z "$path" || "$path" == "$tdir" ]] && continue
        local merged=0
        # epic/* branches are only safe to prune once they've landed on their target branch.
        if [[ "$branch" == epic/* ]]; then
          local epic_issue="${branch#epic/}"
          local parent_target
          parent_target="$(epic_parent_branch "$tdir" "$epic_issue")"
          if git -C "$tdir" merge-base --is-ancestor "$branch" "$parent_target" 2>/dev/null; then
            merged=1
          fi
        else
          # Sub-branches: merged to main OR to any open epic branch.
          if git -C "$tdir" merge-base --is-ancestor "$branch" main 2>/dev/null; then
            merged=1
          else
            local ep
            for ep in "${epic_refs[@]}"; do
              if git -C "$tdir" merge-base --is-ancestor "$branch" "$ep" 2>/dev/null; then
                merged=1; break
              fi
            done
          fi
        fi
        if (( merged )); then
          info "removing merged worktree: $path ($branch)"
          git -C "$tdir" worktree remove "$path" 2>/dev/null || true
          git -C "$tdir" branch -d "$branch" 2>/dev/null || true
        fi
      done < <(git -C "$tdir" worktree list --porcelain \
                | awk '/^worktree /{p=$2} /^branch /{b=$2; sub("^refs/heads/","",b); print p"\t"b}')
      ;;
    list)
      git -C "$tdir" worktree list
      ;;
  esac
}

# ---- top -----------------------------------------------------------------
#
# Live `top`-style dashboard. Single command, refreshes ~1s, quit with q.
# Implemented as a Python script (rich) under uv so we don't add a global
# dep — same pattern as the MCP server.

cmd_top() {
  require_cmd uv
  local legacy=0
  while (( $# )); do
    case "$1" in
      --legacy) legacy=1; shift ;;
      *) shift ;;
    esac
  done
  if (( legacy )); then
    exec uv run --quiet --with textual,rich python3 "$CTO_ROOT/dashboard/ctodashboard.py"
  else
    exec uv run --quiet --with textual,rich python3 "$CTO_ROOT/dashboard/dashboard_v2.py"
  fi
}

cmd_review() {
  require_cmd uv
  exec uv run --quiet --with textual,rich python3 "$CTO_ROOT/dashboard/dashboard_v2.py" "$@"
}

# ---- dashboard -------------------------------------------------------------
#
# Launch the new event-driven dashboard (v2). Same as `top` but explicit.

cmd_dashboard() {
  require_cmd uv
  local legacy=0
  while (( $# )); do
    case "$1" in
      --legacy) legacy=1; shift ;;
      *) shift ;;
    esac
  done
  if (( legacy )); then
    exec uv run --quiet --with textual,rich python3 "$CTO_ROOT/dashboard/ctodashboard.py"
  else
    exec uv run --quiet --with textual,rich python3 "$CTO_ROOT/dashboard/dashboard_v2.py"
  fi
}

# ---- exec ----------------------------------------------------------------

cmd_exec() {
  local name="${1:-}"; shift || true
  require_team "$name"
  if [[ "${1:-}" == "--" ]]; then shift; fi
  (( $# )) || die "exec: command required"
  ( cd "$(team_dir "$name")" && "$@" )
}

# --------------------------------------------------------------------------
# dispatch
# --------------------------------------------------------------------------

main() {
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    "" | -h | --help | help) usage ;;
    team)
      local sub="${1:-}"; shift || true
      case "$sub" in
        create) cmd_team_create "$@" ;;
        adopt)  cmd_team_adopt  "$@" ;;
        list)   cmd_team_list   "$@" ;;
        remove) cmd_team_remove "$@" ;;
        *) die "unknown team subcommand: $sub" ;;
      esac
      ;;
    config)    cmd_config    "$@" ;;
    task)      cmd_task      "$@" ;;
    promote)   cmd_promote   "$@" ;;
    merge)     cmd_merge     "$@" ;;
    merge-epic) cmd_merge_epic "$@" ;;
    inbox)     cmd_inbox     "$@" ;;
    approve)   cmd_approve   "$@" ;;
    reject)    cmd_reject    "$@" ;;
    start)     cmd_start     "$@" ;;
    stop)      cmd_stop      "$@" ;;
    restart)   cmd_restart   "$@" ;;
    attach)    cmd_attach    "$@" ;;
    status)    cmd_status    "$@" ;;
    update)    cmd_update    "$@" ;;
    top)       cmd_top       "$@" ;;
    review)    cmd_review    "$@" ;;
    worktrees) cmd_worktrees "$@" ;;
    dashboard)  cmd_dashboard "$@" ;;
    reconciler-sync) cmd_reconciler_sync "$@" ;;
    activity)  cmd_activity  "$@" ;;
    decisions) cmd_decisions "$@" ;;
    exec)      cmd_exec      "$@" ;;
    *) die "unknown command: $cmd (see: cto help)" ;;
  esac
}

cmd_activity() {
  local name="${1:-}"; shift || true
  require_team "$name"
  local tdir; tdir="$(team_dir "$name")"
  python3 "$CTO_ROOT/src/activity_cli.py" "$tdir" "$@"
}

cmd_decisions() {
  local name="${1:-}"; shift || true
  require_team "$name"
  local tdir; tdir="$(team_dir "$name")"
  python3 "$CTO_ROOT/src/decisions_cli.py" "$tdir" "$@"
}

main "$@"
